# Runtime configuration
PORT=4000
JWT_SECRET=[REDACTED]

# S3-compatible object storage
S3_ENDPOINT=https://[REDACTED]
S3_REGION=auto
S3_BUCKET=[REDACTED]
S3_ACCESS_KEY_ID=[REDACTED]
S3_SECRET_ACCESS_KEY=[REDACTED]
S3_FORCE_PATH_STYLE=true

# Storage limits
STORAGE_MAX_FILE_BYTES=104857600
STORAGE_PRESIGNED_TTL=300
